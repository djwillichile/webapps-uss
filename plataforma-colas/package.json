{
  "name": "plataforma-colas",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de aprendizaje: API segura + cola de trabajos (BullMQ/Redis) + workers",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "api": "node --env-file-if-exists=.env src/api.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "hash-key": "node scripts/hash-key.js",
    "test": "NODE_ENV=test node --test"
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  }
}
