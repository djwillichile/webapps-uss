# Copy to .env and fill in. NEVER commit .env.

# Generate with: npm run hash-key -- <clientId>   (only the hash goes here)
API_KEYS=alice:REPLACE_WITH_SHA256_HASH

# Long random password, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REDIS_PASSWORD=REPLACE_ME
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

PORT=3000
QUEUE_NAME=analisis
MAX_QUEUE_SIZE=100
MAX_SERIES_LENGTH=2000
RATE_LIMIT_PER_MIN=30
WORKER_CONCURRENCY=2
SIMULATED_WORK_MS=3000

# Geospatial worker (Python)
GEO_QUEUE_NAME=geo
# Dataset IDs accepted by the API (must exist in the worker's DATASETS)
GEO_DATASETS=dem-demo
# id=path pairs, server-side only (default: worker-py/data/dem_demo.tif)
# DATASETS=dem-demo=/ruta/dem_demo.tif
GEO_WORKER_CONCURRENCY=2
GEO_MAX_AREA_KM2=5000
GEO_MAX_PIXELS=10000000
# Number of reverse proxies in front of the API (0 if none)
TRUST_PROXY=0
